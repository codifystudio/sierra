{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sierra",
  "version": "4.0.0",
  "identifier": "com.sierra.browser",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Sierra",
        "width": 1200,
        "height": 140,
        "minWidth": 600,
        "minHeight": 140,
        "maxHeight": 140,
        "center": true,
        "decorations": true,
        "resizable": true,
        "fullscreen": false,
        "maximized": false
      }
    ],
    "security": {
      "csp": "default-src * 'unsafe-inline' 'unsafe-eval' data: blob:; img-src * 'unsafe-inline' data: blob:; script-src * 'unsafe-inline' 'unsafe-eval'; connect-src * ws: wss:; frame-src *; style-src * 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "category": "Browser",
    "shortDescription": "Sierra Browser",
    "longDescription": "Sierra — лёгкий, стильный браузер на Rust",
    "copyright": "MIT",
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.13"
    }
  }
}
